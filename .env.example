# Copy to .env and fill in. .env is git-ignored; never commit real secrets.
# Dev-only values: generate your own, e.g. `openssl rand -hex 24`.

# --- MySQL 8 ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=serverwatch
MYSQL_USER=serverwatch
MYSQL_PASSWORD=

# --- Redis ---
REDIS_PASSWORD=

# --- Dashboard (bin/migrate.php, workers) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=serverwatch
DB_USER=serverwatch
DB_PASSWORD=

# --- Ingestion ---
INGEST_LISTEN_ADDR=127.0.0.1:8081
VM_URL=http://127.0.0.1:8428

# --- Agent ---
SERVERWATCH_SERVER_URL=https://monitor.example.com

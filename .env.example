# Copy to .env and fill in. .env is git-ignored; never commit real secrets.
# Dev-only values: generate your own, e.g. `openssl rand -hex 24`.

# --- MySQL 8 ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=serverwatch
MYSQL_USER=serverwatch
MYSQL_PASSWORD=

# --- Redis ---
REDIS_PASSWORD=

# --- Dashboard (bin/migrate.php, workers) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=serverwatch
DB_USER=serverwatch
DB_PASSWORD=

# --- Ingestion ---
INGEST_LISTEN_ADDR=127.0.0.1:8081
VM_URL=http://127.0.0.1:8428

# --- Agent ---
SERVERWATCH_SERVER_URL=https://monitor.example.com

# --- Dashboard app ---
# 32 random bytes, base64. Generate: php -r 'echo base64_encode(random_bytes(32));'
APP_KEY=
# true in any non-local environment (cookies get the __Host- prefix and Secure flag)
COOKIE_SECURE=false
# Throwaway DB used by automated tests; must end in _test (tests refuse to run otherwise)
DB_TEST_NAME=serverwatch_test

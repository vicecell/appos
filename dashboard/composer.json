{
    "name": "serverwatch/dashboard",
    "description": "ServerWatch dashboard and REST control plane (PHP native)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "ServerWatch\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ServerWatch\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "lint": "phpcs",
        "stan": "phpstan analyse --memory-limit=512M",
        "test": "phpunit",
        "check": ["@lint", "@stan", "@test"]
    }
}

<?xml version="1.0"?>
<ruleset name="ServerWatch">
    <description>PSR-12 for the dashboard</description>
    <arg name="colors"/>
    <arg value="p"/>
    <file>app</file>
    <file>public</file>
    <file>tests</file>
    <file>bin</file>
    <rule ref="PSR12"/>
    <!-- PSR-12 soft limit is 120; long SQL/test lines are tolerated up to 140 before a warning. -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="140"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>

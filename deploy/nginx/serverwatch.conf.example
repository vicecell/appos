# Template, not deployed by Sprint 0. Replace server_name and certificate paths.
# Agent traffic goes to the Go ingestion service; everything else to PHP-FPM.
# VictoriaMetrics and MySQL/Redis are NOT exposed here (private network only).

server {
    listen 80;
    server_name monitor.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name monitor.example.com;

    ssl_certificate     /etc/ssl/serverwatch/fullchain.pem;
    ssl_certificate_key /etc/ssl/serverwatch/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;

    client_max_body_size 1m;

    # Agent API -> Go ingestion (per-agent rate limiting is enforced in the service).
    location /api/v1/agent/ {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 30s;
    }

    # Dashboard + control-plane API -> PHP-FPM front controller.
    location / {
        root /var/www/serverwatch/dashboard/public;
        try_files $uri /index.php$is_args$args;
    }

    location = /index.php {
        root /var/www/serverwatch/dashboard/public;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
    }

    location ~ /\. { deny all; }
}
